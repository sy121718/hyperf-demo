APP_NAME=hyperf-demo
APP_ENV=dev

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hyper
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=127.0.0.1
REDIS_AUTH=
REDIS_PORT=6379
REDIS_DB=0

# JWT：HS256 密钥必须设置，留空会导致签发与校验失败
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=7200
JWT_REFRESH_WINDOW=1800
